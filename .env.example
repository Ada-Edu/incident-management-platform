# ---------------------------------------------------------------------------
# Incident Management Platform — environment variables
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Supabase (local dev defaults from `supabase start`) --------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=            # from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=    # from `supabase status` — SERVER ONLY, never ship to client

# --- Frontend (Vite; only VITE_-prefixed vars reach the browser) ------------
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=       # from `supabase status`
VITE_FUNCTIONS_URL=http://localhost:54321/functions/v1

# --- AI provider (edge-function secrets) ------------------------------------
OPENAI_API_KEY=               # leave blank to use the keyword-search fallback
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_AUTOSUGGEST_THRESHOLD=0.82

# --- Zendesk integration (edge-function secrets) ----------------------------
ZENDESK_SUBDOMAIN=            # e.g. mycompany  (mycompany.zendesk.com)
ZENDESK_EMAIL=               # agent email used with the API token
ZENDESK_API_TOKEN=

# --- Temporal worker (Document Field Extraction feature) --------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=incident-main

# --- AWS Bedrock (model call lives in the Temporal worker) ------------------
# In af-south-1, Claude Opus 4.8 must be called via the global cross-region
# inference profile. Auth is a Bedrock API key (bearer token) read by boto3
# from AWS_BEARER_TOKEN_BEDROCK. NEVER commit a real key.
BEDROCK_REGION=af-south-1
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-7
BEDROCK_MAX_TOKENS=4096
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
